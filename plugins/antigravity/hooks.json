{
  "rogue": {
    "PreToolUse": [
      { "matcher": ".*", "hooks": [
        { "type": "command", "command": "env -Ssh ./scripts/hook.sh PreToolUse", "timeout": 30 },
        { "type": "command", "command": "cmd /d /c powershell -NoProfile -NonInteractive -Command . ([scriptblock]::Create((Get-Content -Raw -LiteralPath scripts/hook.ps1))) PreToolUse (Get-Location).Path", "timeout": 30 }
      ] }
    ],
    "PostToolUse": [
      { "matcher": ".*", "hooks": [
        { "type": "command", "command": "env -Ssh ./scripts/hook.sh PostToolUse", "timeout": 30 },
        { "type": "command", "command": "cmd /d /c powershell -NoProfile -NonInteractive -Command . ([scriptblock]::Create((Get-Content -Raw -LiteralPath scripts/hook.ps1))) PostToolUse (Get-Location).Path", "timeout": 30 }
      ] }
    ],
    "PreInvocation": [
      { "type": "command", "command": "env -Ssh ./scripts/hook.sh PreInvocation", "timeout": 30 },
      { "type": "command", "command": "cmd /d /c powershell -NoProfile -NonInteractive -Command . ([scriptblock]::Create((Get-Content -Raw -LiteralPath scripts/hook.ps1))) PreInvocation (Get-Location).Path", "timeout": 30 }
    ],
    "PostInvocation": [
      { "type": "command", "command": "env -Ssh ./scripts/hook.sh PostInvocation", "timeout": 30 },
      { "type": "command", "command": "cmd /d /c powershell -NoProfile -NonInteractive -Command . ([scriptblock]::Create((Get-Content -Raw -LiteralPath scripts/hook.ps1))) PostInvocation (Get-Location).Path", "timeout": 30 }
    ],
    "Stop": [
      { "type": "command", "command": "env -Ssh ./scripts/hook.sh Stop", "timeout": 30 },
      { "type": "command", "command": "cmd /d /c powershell -NoProfile -NonInteractive -Command . ([scriptblock]::Create((Get-Content -Raw -LiteralPath scripts/hook.ps1))) Stop (Get-Location).Path", "timeout": 30 }
    ]
  }
}
